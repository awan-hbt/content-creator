# OpenAI API Key (required)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# YouTube Data API Key (optional - enables YouTube trending topics)
# Get your key at https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Number of trending topics to fetch (optional, defaults to 10)
TRENDING_TOPICS_COUNT=10

# Country code for trending topics (optional, defaults to US)
TRENDING_COUNTRY=US
